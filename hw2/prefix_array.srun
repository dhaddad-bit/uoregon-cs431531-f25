#!/bin/bash
#SBATCH --account=cis431_531
#SBATCH --partition=compute
#SBATCH --job-name=prefix_array
#SBATCH --time=00:15:00
#SBATCH --mem=16000M
#SBATCH --nodes=1
#SBATCH --ntasks-per-node=1
#SBATCH --cpus-per-task=128 # Assume we always have access to max CPUs (for experiments)

# === GOOGLE GEMINI: "SIMPLIFY MY SBATCH submissions" ===
# Run 8 tasks, numbered 0 to 7
#SBATCH --array=0-7

#SBATCH --output=output/prefix_%A_%a.out
#SBATCH --error=output/prefix_%A_%a.err

declare -a THREAD_COUNTS=(1 2 4 8 16 32 64 128)

export OMP_NUM_THREADS=${THREAD_COUNTS[$SLURM_ARRAY_TASK_ID]}

export OMP_PLACES="cores"
export OMP_PROC_BIND='spread' # <-- I will attempt to experiment with thread affinity this time
export OMP_DISPLAY_ENV='true' # prints settings to .err file

echo "--- RUNNING WITH ${OMP_NUM_THREADS} THREADS ---"

./prefix 33554432 5
